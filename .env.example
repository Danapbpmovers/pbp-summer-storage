# Copy to .env.local. Every integration is optional: without a key, that feature
# degrades gracefully (built-in catalog, email logged instead of sent, etc.).

# Supabase (Settings → API). Required for accounts, booking, portal, admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for Stripe redirects and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe (Developers → API keys, and a webhook pointing at /api/stripe/webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (Resend). Without it, messages are written to message_log only.
RESEND_API_KEY=
EMAIL_FROM="PackStoreShip <support@packstoreship.com>"

# SMS (Twilio). Without it, texts are written to message_log only.
# Use a site-only API key (Twilio Console → Account → API keys) rather than the Auth Token.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Sender: the Messaging Service on your registered A2P campaign (recommended), or a single number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
